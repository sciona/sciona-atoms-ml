      },
      {
        "name": "val_data",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "transformer_template",
        "type_desc": "Any",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "transformed_train",
        "type_desc": "NDArray[np.float64]"
