      ],
      "outputs": [
        {"name": "result", "type_desc": "NDArray[np.float64]"}
      ]
    },
    {
      "node_id": "mincovdet_corrected_distances",
      "name": "mincovdet_corrected_distances",
      "status": "atomic",
      "kind": "atom",
      "description": "Scale raw squared distances by the inverse MinCovDet empirical correction factor.",
      "type_signature": "(raw_distances: NDArray[np.float64], correction_factor: float) -> NDArray[np.float64]",
