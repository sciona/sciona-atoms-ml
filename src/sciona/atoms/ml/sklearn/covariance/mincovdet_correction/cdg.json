        {"name": "raw_support", "type_desc": "NDArray[np.bool_]", "required": true},
        {"name": "raw_distances", "type_desc": "NDArray[np.float64]", "required": true}
      ],
      "outputs": [
        {"name": "result", "type_desc": "bool"}
      ]
    },
    {
      "node_id": "mincovdet_empirical_correction_factor",
      "name": "mincovdet_empirical_correction_factor",
      "status": "atomic",
      "kind": "atom",
      "description": "Compute MinCovDet's empirical covariance-correction factor from raw squared distances and the feature count.",
      "type_signature": "(raw_distances: NDArray[np.float64], n_features: int) -> float",
      "inputs": [
        {"name": "raw_distances", "type_desc": "NDArray[np.float64]", "required": true},
        {"name": "n_features", "type_desc": "int", "required": true}
      ],
      "outputs": [
        {"name": "result", "type_desc": "float"}
      ]
    },
    {
      "node_id": "mincovdet_corrected_covariance",
      "name": "mincovdet_corrected_covariance",
      "status": "atomic",
      "kind": "atom",
      "description": "Scale raw covariance by MinCovDet's empirical correction factor.",
      "type_signature": "(raw_covariance: NDArray[np.float64], correction_factor: float) -> NDArray[np.float64]",
      "inputs": [
        {"name": "raw_covariance", "type_desc": "NDArray[np.float64]", "required": true},
