{
  "cdg_id": "text_tfidf_vectorization",
  "name": "text_tfidf_vectorization",
  "priority": "medium",
  "decomposition_rationale": "Decouple token counting (CountVectorizer) from numerical TF-IDF transformation (TfidfTransformer) so that counts can be inspected and verified independently.",
