        {
          "name": "norm",
          "type_desc": "str",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "tfidf_matrix",
          "type_desc": "Any"
        }
      ],
      "precondition_candidates": [],
      "postcondition_candidates": [],
      "witness_shape_semantics": "Outputs matrix with identical shape as input count matrix, scaled to unit length.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    }
  ],
