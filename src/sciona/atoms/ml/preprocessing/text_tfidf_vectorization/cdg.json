      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "apply_tfidf_weighting",
      "semantic_role": "Transform raw occurrences into relative importance weights using IDF logarithmic scaling.",
      "source_targets": [
        "sklearn.feature_extraction.text.TfidfTransformer"
      ],
      "inputs": [
        {
          "name": "raw_counts",
          "type_desc": "Any",
          "required": true
